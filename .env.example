# Copie para .env e preencha.

# Conexão PostgreSQL usada pelo Prisma.
# Local (Docker): postgresql://petroprep:petroprep@localhost:5432/petroprep?schema=public
DATABASE_URL="postgresql://petroprep:petroprep@localhost:5432/petroprep?schema=public"

# URL pública do site (usada em metadados/OpenGraph). Sem barra no final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
