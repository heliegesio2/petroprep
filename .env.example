# Copie para .env e preencha.  (No Windows:  copy .env.example .env)

# Conexão PostgreSQL usada pelo Prisma.
# Rodando o Postgres via docker compose, a porta no host é a 5434:
DATABASE_URL="postgresql://petroprep:petroprep@localhost:5434/petroprep?schema=public"

# URL pública do site (usada em metadados, back_urls do checkout). Sem barra no final.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"

# Segredo para assinar a sessão de login (JWT em cookie). Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Mercado Pago (checkout). Pegue no painel de desenvolvedor, use as de TESTE.
# https://www.mercadopago.com.br/developers/panel
# Sem o access token, o botão Assinar só registra a intenção (não cobra).
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# Login social. Cada provedor some da tela se as 2 chaves dele não estiverem aqui.
# Redirect URI (OAuth) a cadastrar em cada provedor:
#   http://localhost:3100/api/auth/google/callback
#   http://localhost:3100/api/auth/facebook/callback
#   http://localhost:3100/api/auth/tiktok/callback
# (troque o host pela URL de produção quando for o caso)
#
# Google:   https://console.cloud.google.com/apis/credentials  (OAuth client "Web")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Facebook: https://developers.facebook.com/apps  (produto "Login do Facebook")
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# TikTok:   https://developers.tiktok.com/apps  (produto "Login Kit", scope user.info.basic)
# O TikTok não fornece e-mail: a conta é criada sem e-mail e ele é pedido depois.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
