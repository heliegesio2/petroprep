# Copie para .env e preencha.  (No Windows:  copy .env.example .env)

# Conexão PostgreSQL usada pelo Prisma.
# Rodando o Postgres via docker compose, a porta no host é a 5433:
DATABASE_URL="postgresql://petroprep:petroprep@localhost:5433/petroprep?schema=public"

# URL pública do site (usada em metadados/OpenGraph). Sem barra no final.
NEXT_PUBLIC_SITE_URL="http://localhost:3100"
